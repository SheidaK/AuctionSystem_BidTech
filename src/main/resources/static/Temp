<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment — BidTech</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { colors: { brand: { DEFAULT: '#667eea', dark: '#5568d3' } } } }
        }
    </script>
    <style>
        .bg-brand-gradient { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .bg-nav-gradient   { background: linear-gradient(135deg, #4a3f8f 0%, #5a2d82 100%); }
    </style>
</head>
<body class="bg-brand-gradient min-h-screen font-sans">

<nav class="bg-nav-gradient shadow-lg">
    <div class="max-w-6xl mx-auto px-6 flex items-center gap-1">
        <span class="text-white font-bold text-lg py-4 pr-5 mr-3 border-r border-white/20">🏛️ BidTech</span>
        <a href="/index.html" class="text-white/85 px-4 py-4 text-sm font-medium rounded hover:bg-white/15 transition">📦 Catalogue</a>
        <a href="/auction.html" class="text-white/85 px-4 py-4 text-sm font-medium rounded hover:bg-white/15 transition">🔨 Auction</a>
        <a href="/users.html" class="text-white/85 px-4 py-4 text-sm font-medium rounded hover:bg-white/15 transition">👤 Users</a>
        <a href="/pay.html" class="text-white bg-white/20 px-4 py-4 text-sm font-medium rounded hover:bg-white/30 transition">💳 Payment</a>
        <script>
            const user = JSON.parse(localStorage.getItem('user') || '{}');
            if (user.role === 'ADMIN') {
                document.write('<a href="/notifications.html" class="text-white/85 px-4 py-4 text-sm font-medium rounded hover:bg-white/15 transition">🔔 Notifications</a>');
            }
        </script>
        <button onclick="logout()" class="text-white px-4 py-2 hover:bg-white/20 rounded">🚪 Logout</button>
    </div>
</nav>

<div class="max-w-4xl mx-auto my-8 bg-white rounded-2xl shadow-2xl overflow-hidden">

    <header class="bg-brand-gradient text-white px-8 py-8">
        <h1 class="text-3xl font-bold mb-1">💳 Payment Service</h1>
        <p class="text-white/90">Review and confirm payments for your won auctions</p>
    </header>

    <div class="p-8">

        <div id="pendingPayments" class="space-y-6">
            <p class="text-gray-500 font-medium text-center py-4">Checking your pending payments...</p>
        </div>

        <div id="processResult" class="hidden mt-6 px-6 py-4 rounded-2xl text-center text-lg font-medium"></div>
    </div>
</div>

<script>
    async function loadWinnerInfo() {
        const user = JSON.parse(localStorage.getItem('user'));
        const container = document.getElementById('pendingPayments');

        if (!user || !user.id) {
            container.innerHTML = `<div class="bg-red-50 text-red-800 p-6 rounded-2xl text-center font-medium">Please log in to view your pending payments.</div>`;
            return;
        }

        try {
            // Get all auctions
            const res = await fetch('/auction/all');
            const auctions = await res.json();

            const wonAuctions = auctions.filter(a => !a.active && a.highestBidderId === user.id);

            if (wonAuctions.length === 0) {
                container.innerHTML = `
                    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-8 text-center">
                        <h3 class="font-semibold text-xl text-gray-700">No pending payments</h3>
                        <p class="text-gray-500 mt-2">You haven't won any unpaid auctions yet.</p>
                    </div>`;
                return;
            }

            container.innerHTML = '';

            for (const auction of wonAuctions) {
                const productRes = await fetch(`/api/catalogue/products/${auction.itemId}`);
                const product = await productRes.json();

                const safeProductName = product.name.replace(/'/g, "\\'");

                const card = document.createElement('div');
                card.className = 'bg-green-50 border border-green-200 rounded-2xl p-6 flex flex-col md:flex-row justify-between items-center gap-4';
                card.innerHTML = `
                    <div class="flex-1 text-center md:text-left">
                        <h3 class="font-semibold text-green-800 mb-1">🏆 You won this auction!</h3>
                        <p class="text-2xl font-medium text-gray-800">Item: <strong>${product.name}</strong></p>
                        <p class="text-sm text-gray-500 mt-1">Auction ID: #${auction.id}</p>
                    </div>
                    <div class="text-center md:text-right">
                        <p class="text-3xl font-bold text-brand mb-3">$${auction.highestBid.toFixed(2)}</p>

                        <button onclick="processPayment(${auction.id}, ${auction.highestBid}, '${safeProductName}')"
                                class="w-full md:w-auto px-8 py-3 bg-green-600 hover:bg-green-700 text-white text-lg font-semibold rounded-xl transition shadow-sm">
                            💳 Pay Now
                        </button>
                    </div>
                `;
                container.appendChild(card);
            }
        } catch (e) {
            console.error(e);
            container.innerHTML = `<div class="bg-red-50 text-red-800 p-6 rounded-2xl text-center font-medium">Error loading payments: ${e.message}</div>`;
        }
    }

    async function processPayment(auctionId, amount, itemName) {
        const user = JSON.parse(localStorage.getItem('user'));

        if (!user || !user.id) {
            alert("Please log in first.");
            return;
        }

        try {
            const res = await fetch(`/api/payments/process?auctionId=${auctionId}&userId=${user.id}&amount=${amount}`, { method: 'POST' });
            const result = await res.text();

            if (result.startsWith("Please") || result.startsWith("Negative")) {
                showMsg('processResult', '❌ ' + result, 'error');
            } else {
                showMsg('processResult', `✅ Payment successful! Redirecting to catalogue...`, 'success');

                const winnerIdentifier = user.username || user.id;
                const notificationMsg = `winner ${winnerIdentifier} has paid for item ${auctionId} (${itemName})`;

                const notifications = JSON.parse(localStorage.getItem('notifications') || '[]');
                notifications.push({ message: notificationMsg, timestamp: new Date().toISOString() });
                localStorage.setItem('notifications', JSON.stringify(notifications));

                setTimeout(() => {
                    window.location.href = '/index.html';
                }, 2000);
            }
        } catch (err) {
            showMsg('processResult', '❌ ' + err.message, 'error');
        }
    }

    function showMsg(id, text, type) {
        const el = document.getElementById(id);
        const styles = {
            success: 'bg-green-50 text-green-800 border border-green-200',
            error:   'bg-red-50 text-red-800 border border-red-200'
        };
        el.className = `px-6 py-4 rounded-2xl text-lg font-medium mt-6 ${styles[type]}`;
        el.textContent = text;
        el.classList.remove('hidden');
    }

    function logout() {
        localStorage.clear();
        window.location.href = '/login.html';
    }

    // Auto-load when page opens
    window.onload = loadWinnerInfo;
</script>

<script src="chat-widget.js"></script>
</body>
</html>



public String processPayment(Long auctionId, Long userId, double amount, String itemName) {
        Auction auction = auctionRepository.findById(auctionId)
                .orElseThrow(() -> new RuntimeException("Auction not found"));

        if (!auction.getHighestBidderId().equals(userId)) {
            return "Please log in as the winner to pay.";
        }

        if (amount < 0) {
            return "Negative payment amount is not allowed.";
        }

        Payment payment = new Payment();
        payment.setAuctionId(auctionId);
        payment.setUserId(userId);
        payment.setAmount(amount);
        payment.setTransactionId(String.valueOf(System.currentTimeMillis()));
        payment.setStatus("COMPLETED");

        paymentRepository.save(payment);

        User user = userRepository.findById(userId).get();
        String notificationMsg = "winner " + user.getUserName() + " has paid for item " + auctionId + " (" + auctionId + " + " + itemName + ")";
        notificationListener.addNotification(notificationMsg);

        return payment.getTransactionId();
    }
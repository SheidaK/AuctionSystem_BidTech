{
  "info": {
    "name": "Catalogue Service API",
    "description": "Complete test collection for Catalogue Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/catalogue"
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Get All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        }
      }
    },
    {
      "name": "Get Active Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/active",
          "host": ["{{baseUrl}}"],
          "path": ["products", "active"]
        }
      }
    },
    {
      "name": "Create Product - Valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.environment.set(\"productId\", jsonData.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"iPhone 15 Pro\",\n  \"description\": \"Latest iPhone with A17 Pro chip\",\n  \"category\": \"Electronics\",\n  \"startingPrice\": 800.00,\n  \"reservePrice\": 1000.00,\n  \"sellerId\": 1,\n  \"condition\": \"NEW\",\n  \"quantity\": 1,\n  \"imageUrl\": \"https://example.com/iphone.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        }
      }
    },
    {
      "name": "Get Product By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        }
      }
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"iPhone 15 Pro Max\",\n  \"description\": \"Latest iPhone with A17 Pro chip and larger display\",\n  \"startingPrice\": 900.00,\n  \"reservePrice\": 1100.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        }
      }
    },
    {
      "name": "Activate Product",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}/activate",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}", "activate"]
        }
      }
    },
    {
      "name": "Deactivate Product",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}/deactivate",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}", "deactivate"]
        }
      }
    },
    {
      "name": "Search Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?keyword=iPhone",
          "host": ["{{baseUrl}}"],
          "path": ["products", "search"],
          "query": [
            {
              "key": "keyword",
              "value": "iPhone"
            }
          ]
        }
      }
    },
    {
      "name": "Get Products By Category",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/category/Electronics",
          "host": ["{{baseUrl}}"],
          "path": ["products", "category", "Electronics"]
        }
      }
    },
    {
      "name": "Get Products By Seller",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/seller/1",
          "host": ["{{baseUrl}}"],
          "path": ["products", "seller", "1"]
        }
      }
    },
    {
      "name": "Get Products By Price Range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/price-range?min=500&max=1500",
          "host": ["{{baseUrl}}"],
          "path": ["products", "price-range"],
          "query": [
            {
              "key": "min",
              "value": "500"
            },
            {
              "key": "max",
              "value": "1500"
            }
          ]
        }
      }
    },
    {
      "name": "Update Product Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_AUCTION\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}", "status"]
        }
      }
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        }
      }
    },
    {
      "name": "ERROR - Create Product Missing Fields",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Incomplete Product\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        }
      }
    },
    {
      "name": "ERROR - Invalid Price Range",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Invalid Product\",\n  \"description\": \"Test\",\n  \"category\": \"Test\",\n  \"startingPrice\": 1000.00,\n  \"reservePrice\": 500.00,\n  \"sellerId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        }
      }
    },
    {
      "name": "ERROR - Negative Price",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Negative Price Product\",\n  \"description\": \"Test\",\n  \"category\": \"Test\",\n  \"startingPrice\": -100.00,\n  \"reservePrice\": 500.00,\n  \"sellerId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        }
      }
    },
    {
      "name": "ERROR - Get Non-Existent Product",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/99999",
          "host": ["{{baseUrl}}"],
          "path": ["products", "99999"]
        }
      }
    }
  ]
}
